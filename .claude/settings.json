{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/git-sync-check.sh\"",
            "timeout": 20,
            "statusMessage": "Checking git sync with remote..."
          }
        ]
      }
    ]
  }
}
